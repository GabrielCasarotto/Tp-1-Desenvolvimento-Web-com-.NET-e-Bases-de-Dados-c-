@page
@model Tp_1_C__ASP_NET.Pages.AddProductModel
@{
    ViewData["Title"] = "Cadastrar Produto";
}

<div class="container mt-4">
    <h2>Cadastrar Novo Produto</h2>

    <form method="post" class="mt-3">
        <div class="mb-3">
            <label asp-for="Nome" class="form-label">Nome do Produto:</label>
            <input asp-for="Nome" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Preco" class="form-label">Preço (R$):</label>
            <input asp-for="Preco" type="number" step="0.01" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary">Cadastrar</button>
    </form>

    @if (Model.DadosEnviados)
    {
        <div class="alert alert-success mt-4 shadow-sm">
            <h4 class="alert-heading">Produto Cadastrado com Sucesso!</h4>
            <hr />
            <p class="mb-1"><strong>Nome:</strong> @Model.Nome</p>
            <p class="mb-0"><strong>Preço:</strong> R$ @Model.Preco.ToString("F2")</p>
        </div>
    }
</div>