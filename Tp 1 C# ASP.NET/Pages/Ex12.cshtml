@page
@model Tp_1_C__ASP_NET.Pages.Ex12Model
@{
}

<div class="container mt-4">
    <h2>Cadastro evento</h2>

    <form method="post" class="mt-3">
        <div class="mb-3">
            <label asp-for="Evento.Titulo" class="form-label">Título do Evento:</label>
            <input asp-for="Evento.Titulo" class="form-control" placeholder="Ex: Workshop ASP.NET" required />
        </div>

        <div class="mb-3">
            <label asp-for="Evento.Data" class="form-label">Data:</label>
            <input asp-for="Evento.Data" type="date" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Evento.Local" class="form-label">Local:</label>
            <input asp-for="Evento.Local" class="form-control" placeholder="Ex: Auditório / Online" required />
        </div>

        <button type="submit" class="btn btn-success">registrar evento</button>
    </form>

    @if (Model.EventoCriado)
    {
        <div class="alert alert-success mt-4 shadow-sm">
            <h4 class="alert-heading">Evento Registrado</h4>
            <p>delegate gerado.</p>
            <hr />
            <p class="mb-1"><strong>Título:</strong> @Model.Evento.Titulo</p>
            <p class="mb-1"><strong>Data:</strong> @Model.Evento.Data.ToString("dd/MM/yyyy")</p>
            <p class="mb-0"><strong>Local:</strong> @Model.Evento.Local</p>
        </div>
    }
</div>